{
  "name": "@ontofelia/eval",
  "version": "0.0.1",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "node -e \"const fs=require('fs'),path=require('path');for(const d of['scenarios','behavior/scenarios']){const src=path.join('src',d),dst=path.join('dist',d);fs.mkdirSync(dst,{recursive:true});fs.readdirSync(src).filter(f=>f.endsWith('.json')).forEach(f=>fs.copyFileSync(path.join(src,f),path.join(dst,f)))}\"",
    "test": "vitest run",
    "lint": "eslint src",
    "pilot": "node dist/pilot.js",
    "behavior": "node dist/behaviorPilot.js",
    "score-kappa": "node dist/scoreKappa.js"
  },
  "dependencies": {
    "@ontofelia/core": "workspace:*",
    "@ontofelia/providers": "workspace:*",
    "@ontofelia/semantic-memory": "workspace:*"
  },
  "devDependencies": {
    "typescript": "~5.7.0",
    "vitest": "^2.0.5"
  },
  "license": "Apache-2.0"
}
